//-----------------------------------------------------------------------------
WEBPROC Negocio() PATH TC
   Static cTemplate
   Local cSID := oClient:GetSessionHandle()
   Local cLinks

   debug( "TC_Negocio: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

   if cTemplate == NIL
      TEXT INTO cTemplate TRIMMED
      <html>
      <head>
       <title>Datos del Negocio</title>
       <link rel="stylesheet" media="screen" type="text/css" href="/style.css">
       <style type="text/css">
	</style>
	</head>
	<body BGCOLOR="FFFAFF">
	<HR>
	<TABLE ALIGN="CENTER" width="99%">
	<TR>
	<TD align='left'> <b><a href="TimeClock?" target = main >Menu</a></b> </TD> <TD> <font color = "#000080"><center><B><%EMPRESA%></center></font>  </TD> <TD align='right'>usuario: <%EMPLEADO%></B> </TD>
	</TR>
	</TABLE>
	<HR>
	</body>
	</html>
      ENDTEXT
   endif

   cTemplate := StrTran(cTemplate, "<%cSID%>"   , cSID,1, 1)
   cTemplate := StrTran(cTemplate, "<%EMPRESA%>"   , Alltrim(aINFOKEY[3]),1, 1)
   cTemplate := StrTran(cTemplate, "<%EMPLEADO%>"   , ALLTRIM(oClient:GetCargo("NAME")) ,1, 1)
   oClient:HTTPResponse:Content := StrTran(cTemplate, "<%links%>", cLinks, 1, 1)

Return


//-----------------------------------------------------------------------------
WEBPROC TimeClock() PATH TC
   GETCARGO UID    AS nID
   GETVAR   ACTION AS cAction
   Local cTime, cFilter, cDate, aParam

   debug( "TimeClock: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

   CHECKLOGIN

   Debug("Action:", cAction, oClient:GetCargo())

   DEFAULT cAction TO ""

   cAction := Upper(cAction)

   do case
   case cAction == "SALIR"
      WEB_TC_Logout()
      Return

   endcase

   oClient:HTTPResponse:Content := BuildTimeClockPage(;
                                       oClient:GetCargo("NAME"), ;
                                       oClient:GetCargo("CLOCKIN"), ;
                                       oClient:GetCargo("CLOCKOUT"), ;
                                       oClient:GetCargo("EXCEPTIONS"))
   Return




