*
* RESULTADOS
*
WEBPROC PRECIOS4() PATH TC
Local cHTML := ''
   Local cCOD_FAMILI := oClient:GetVar("familia")
	Local cCOD_ALMA := cCOD_MAIN_ALMA

	cFILENAME := cDBFPATH + 'PRODUCTO.DBF'

   if FExists( cFileName ) .AND. .NOT. EMPTY(cCOD_FAMILI)

		aFILES := dARRAY({'PRODUCTO','CODIGOS','ESCALAS','PRECIOS','FAMILIAS','SIZE','ATRIB'})
		fVIDMAIN(.t., aFILES)

		FAMILIAS->( ordsetfocus( 1))
		FAMILIAS->(DbSeek(cCOD_FAMILI))

		TEXT INTO cHtml TRIMMED
			<BR><B><FONT SIZE="12">RESULTADOS :</B><BR>
			<TABLE><TABLE BORDER='5'>
			<TR><TD BGCOLOR="FFCCFF">PLU</TD><TD BGCOLOR="FFCCFF">DESCRIPCION</TD><TD BGCOLOR="FFCCFF">PRECIO</TD></TR>
		ENDTEXT

		PRODUCTO->( ordsetfocus( 7))
		PRODUCTO->(DbSeek(cCOD_FAMILI))
		Do While .not. PRODUCTO->(Eof()) .and. cCOD_FAMILI == PRODUCTO->COD_FAMILI

			CODIGOS->( ordsetfocus( 1))
			If CODIGOS->(DbSeek(PRODUCTO->COD_PROD))

				/*
				cHtml+='<TR><TD>'+CODIGOS->COD_PLU+'</TD><TD>'+PRODUCTO->DES_PROD+'</TD><TD>'+ Trans(0,'$999,999.99') +'</TD></TR>'
				*/

				PRECIOS->( ordsetfocus(1))
				If PRECIOS->(DbSeek(PRODUCTO->COD_PROD))
					cHtml+='<TR><TD>'+CODIGOS->COD_PLU+'</TD><TD>'+PRODUCTO->DES_PROD+'</TD><TD>'+ Trans(PRECIOS->ACTIVO,'$999,999.99') +'</TD></TR>'
				EndIf
				
			EndIf
			
			PRODUCTO->(DbSkip())
		EndDo

		cHtml+='</TABLE>'

		cHTML+= FAMILIAS->CONCEPTO+'<BR>'

		oClient:HTTPResponse:Content  := cHtml
		fVIDMAIN(.f., aFILES)

   else
      FlashError('** ERROR **')
   endif

RETURN NIL




*
* AJUSTE DE INVENTARIO
*
WEBPROC AjusteInv1() PATH TC
Local cPLU      := oClient:GetVar("PLU")
Local cFILENAME, aFILES, cHTML := ''
Local nFISICO := 0
Local cCOD_PLU, lFOUND := .F.

If fvACCESO(9)

	cFILENAME := cDBFPATH + 'PRODUCTO.DBF'

	if FExists( cFileName )


	If .not. EMPTY(cPLU)
	
		aFILES := dARRAY({'PRODUCTO','CODIGOS','STOCKS'})
		fVIDMAIN(.t., aFILES)

		cCOD_PLU := Space(15-len(cPLU)) + cPLU
		CODIGOS->( ordsetfocus( 2))
		If CODIGOS->(DbSeek(cCOD_PLU))

			PRODUCTO->( ordsetfocus( 1))
			If PRODUCTO->(DbSeek(CODIGOS->COD_PROD))

				STOCKS->( ordsetfocus( 2))
				If STOCKS->(DbSeek(PRODUCTO->COD_PROD + cCOD_MAIN_ALMA + CODIGOS->SIZE + CODIGOS->ATRIB))
				
					lFOUND := .T.
				
					oClient:SetCargo("PLU", cCOD_PLU)
				
					TEXT INTO cHtml TRIMMED
						<BR><CENTER><B><H4>AJUSTE DE INVENTARIO :</B></H4><BR></CENTER>
						<TABLE  ALIGN="CENTER" width="75%" BORDER='0'>
						<TR><TD BGCOLOR="#000070"><font color = "#999999"><B>PLU</B></TD><TD BGCOLOR="#000070"><font color = "#999999"><B>DESCRIPCION</B></TD><TD BGCOLOR="#000070"><font color = "#999999"><B>EXISTENCIA</B></TD></TR>
					ENDTEXT

					cHtml+='<TR><TD>'+CODIGOS->COD_PLU+'</TD><TD>'+PRODUCTO->DES_PROD+'</TD><TD>'+ Trans(STOCKS->EXISTE,'999,999,999.999') +'</TD></TR>'
					
				EndIf
			EndIf
		Else
			cHtml += '<BR><BR><CENTER><H2>NO SE ENCONTRO CODIGO PLU : ' + cPLU+ '<br></H2></CENTER>'
		EndIf
		
		fVIDMAIN(.f., aFILES)
		

	EndIf

	cHtml+='</TABLE>'
	cHTML+= '<BR><BR>'

	If lFOUND
		cHtml+="<form name='login' method='post' action='AjusteInv2'>"
		cHtml+="<tr><td class=prompt>FISICO:&nbsp;</td><td class=field><input type=text id = 'miplu' name='FISICO' maxlength=15 size=16></td></tr>"
		cHtml+="<tr><td colspan=2 class=footer><input type=submit value='Ajustar' width=250px style='width:80px; font:bold 12px verdana;'></td></tr>"
		cHtml+="</form>"

		cHTML+= '<BR><BR>'
		cHTML+= '<H3><td class="link"><a =\TC\ajusinv.htm class="cold" title="">Regresar</a></td></H3>'
		cHTML+= "<script language='javascript'>document.login.miplu.focus();</script>"
	Else
	/*
		cHTML+= '<BR><BR>'
		cHTML+= '<H3><td class="link"><a href=\TC\ajusinv.htm class="cold" title="" ID = "miplu" >Continuar</a></td></H3>'
	*/
		oClient:SendFile( oClient:Parent:RootDir + "\TC\ajusinv.htm" )
	EndIf

	oClient:HTTPResponse:Content  := cHtml

	EndIf
Else
	FlashError('** NO TIENE ACCESO **')
Endif

Return


WEBPROC AjusteInv2() PATH TC
Local cFISICO := oClient:GetVar("FISICO")
Local cPLU := Alltrim(ThreadObject():GetCargo("PLU")) // OJO IMPORTANTE !!!!
Local dFECHA, nAJUSTE, nFISICO
Local aFILES := dARRAY({'PRODUCTO','CODIGOS','STOCKS'}) // OJO ARCHIVOS SE MANEJAN LOCALES EN CADA FUNCION !!

If .not. empty(cFISICO) .and. .not. EMPTY(cPLU)

	cCOD_PLU := Space(15-len(cPLU)) + cPLU

	fVIDMAIN(.t., aFILES)

	nFISICO := VAL(cFISICO)
	
	CODIGOS->( ordsetfocus( 2))
	If CODIGOS->(DbSeek(cCOD_PLU))

		PRODUCTO->( ordsetfocus( 1))
		If PRODUCTO->(DbSeek(CODIGOS->COD_PROD))

			STOCKS->( ordsetfocus( 2))
			If STOCKS->(DbSeek(PRODUCTO->COD_PROD + cCOD_MAIN_ALMA + CODIGOS->SIZE + CODIGOS->ATRIB))
			
				nAJUSTE := nFISICO - STOCKS->EXISTE

				*
				* Actualizar Existencia
				*
				If nAJUSTE <> 0

					dFECHA := DATE()
					fMOV_DET(dFECHA)               // ABRIR MOV_DET DEL DIA

					If STOCKS->(RLock())
						Replace STOCKS->EXISTE with nFISICO
						STOCKS->(DbUnLock())
					EndIf

					*
					* Actualiza Ajuste de Articulo : MOV_DET
					*
					
					If MOV_DET->(RLock())
						MOV_DET->(DbAppend())
						Replace MOV_DET->FOLIO     with 'W'+StrZero(Day(DATE()),2)+ StrZero(month(DATE()),2) + Substr(StrZero(Year(DATE()),4),-2),;
						MOV_DET->COD_ALMA  with cCOD_MAIN_ALMA,;
						MOV_DET->TIPO_MOV  with '1',;
						MOV_DET->COD_PROD  with CODIGOS->COD_PROD,;
						MOV_DET->ATRIB     with CODIGOS->ATRIB,;
						MOV_DET->SIZE      with CODIGOS->SIZE,;
						MOV_DET->CANTIDAD  with nAJUSTE,;
						MOV_DET->PRECIO    with PRODUCTO->COSTO,;
						MOV_DET->COSTO     with PRODUCTO->COSTO,;
						MOV_DET->HORA       with SUBSTR(TIME(),1,5),;
						MOV_DET->EXISTENCIA with nFISICO

						MOV_DET->(DbUnLock())
					Endif

					If CODIGOS->SIZE <> '00' .and. CODIGOS->ATRIB <> '00'
						*
						* MATRIZ CONSOLIDADA : ACTUALIZA EXISTENCIAS
						*
						STOCKS->( ordsetfocus( 2 ))
						If STOCKS->(DbSeek(PRODUCTO->COD_PROD + cCOD_MAIN_ALMA + '00' + '00' ))
							If STOCKS->(RLock())
								Replace STOCKS->EXISTE with STOCKS->EXISTE + nAJUSTE
								STOCKS->(DbUnLock())
							EndIf
						EndIf

					EndIf
					
					MOV_DET->( DbCloseArea() )
				
				EndIf

			EndIf
		EndIf
	EndIf
	fVIDMAIN(.f., aFILES)
	
EndIf

oClient:SendFile( oClient:Parent:RootDir + "\TC\ajusinv.htm" )

Return NIL

WEBPROC mitono() PATH TC
TONE(300,3)
return NIL
