#include "xb2net.ch"
#include "common.ch"
#pragma  library ("xb2net.lib")

#xtranslate NTrim(<n>)        =>  LTrim(Str(<n>))

//#xtranslate Debug([<p,...>])  =>  QOut(<p>)
#xtranslate Debug([<p,...>])  =>
// security levels:
#define SEC_NONE          0
#define SEC_EMPLOYEE      1
#define SEC_SUPERVISOR    2
#define SEC_ADMIN         3

#xtranslate GETVAR <(name)> AS <var>     => Local <var> := oClient:GetVar(<(name)>)
#xtranslate GETCARGO <(name)> AS <var>   => Local <var> := oClient:GetCargo(<(name)>)
#xtranslate GETCOOKIE <(name)> AS <var>  => Local <var> := oClient:GetCookie(<(name)>)

#command WEBPROCEDURE <name>([<param,...>])         ;
         [VAR <(fname)> AS <fvar>]                  ;
         [COOKIE <(cname)> AS <cvar>]               ;
         [CARGO <(sname)> AS <svar>]                ;
            => PROCEDURE WEB_<name>(<param>)        ;
               ; Local oClient := ThreadObject()    ;
               [; GETVAR <(fname)> AS <fvar>]       ;
               [; GETCOOKIE <(cname)> AS <cvar>]    ;
               [; GETCARGO <(sname)> AS <svar>]

#command WEBPROCEDURE <name>([<param,...>])         ;
         PATH <path>                                ;
         [VAR <(fname)> AS <fvar>]                  ;
         [COOKIE <(cname)> AS <cvar>]               ;
         [CARGO <(sname)> AS <svar>]                ;
            => PROCEDURE WEB_<path>_<name>(<param>) ;
               ; Local oClient := ThreadObject()    ;
               [; GETVAR <(fname)> AS <fvar>]       ;
               [; GETCOOKIE <(cname)> AS <cvar>]    ;
               [; GETCARGO <(sname)> AS <svar>]

#command CHECKLOGIN ;
         => if ! isLoggedIn() ;
         ;     return ;
         ;  endif

#command CHECKLOGIN SECURITY [<nSecLevel>] ;
         => if ! isLoggedIn() .or. ! HaveSecurityPrivilege(<nSecLevel>) ;
         ;     return ;
         ;  endif


//-----------------------------------------------------------------------------
// This function is the entry point into the TimeClock app
//
WEBPROC Login() PATH TC
	GETVAR UID AS cUID
	GETVAR PWD AS cPWD
	Local lUpdate  := .t.
	Local cMessage := ""
	Local oServer  := oClient:Parent  // this is the xbHTTPServer object
	Local nID
	Local cFILENAME := cDBFPATH + 'PAREA.DBF', aFILES

	   oClient:CloseSession()

	   debug( "TC_Login 1: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

	   if Empty(cUID) .or. .not. FExists( cFileName )
	      // no user ID specified - redisplay login screen
	      oClient:SendFile( oServer:RootDir + "\TC\Login.htm" )
	      Return
	   endif

	aFILES := dARRAY({'PAREA'})
	fVIDMAIN(.t., aFILES)

	PAREA->( ordsetfocus( 5))
	If .not. ( PAREA->(DbSeek(UPPER(cPWD))) .and. Upper(ALLTRIM(cUID)) == UPPER(ALLTRIM(PAREA->DES_EMPLEA)) .and. PAREA->FTP .and. ALLTRIM(UPPER(cPWD)) ==  ALLTRIM(UPPER(PAREA->PASSWORD)) .AND. .NOT. EMPTY(cPWD) .and. .not. fFUERA_HORARIO())
	      dbCLoseAll()
	      oClient:SendFile( oServer:RootDir + "\TC\Login.htm" )
		Return
	EndIf

	   // we have a valid userid/password

	   // make sure any previous session is properly closed
	   oClient:CloseSession()

	   // the GetCargo/SetCargo methods will automatically open a new session to keep track of this guy

	   if oClient:GetCargo("UID") != NIL
	      if oClient:GetCargo("UID") == nID
		 // same guy, don't update login count in password table
		 lUpdate := .f.
	      else
		 // this client was previously logged in under a different userid
		 // close the old session
		 oClient:CloseSession()
	      endif
	   endif

	   oClient:SetCargo("UID"       , cUID)
	   oClient:SetCargo("NAME"      , AllTrim(PAREA->DES_EMPLEA))
	   oClient:SetCargo("SECURITY"  , 3 )  // save the security level   PAREA->ACCESO_3
	   oClient:SetCargo("EXCEPTIONS", 'NADA' ) // emp->(GetExceptions())
	   oClient:SetCargo("ACCESO_3"  , PAREA->ACCESO_3 ) 
	   
	   fVIDMAIN(.F., aFILES)

	   debug( "TC_Login 2: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

	   // attach the response string to the HTTP response object
	   oClient:HTTPResponse:Content := DrawOuterFrame( oClient:GetSessionHandle() )
	   

 Return
 
 

//-----------------------------------------------------------------------------
// Close session and exit TimeClock app. Client browser is taken back to Login screen.
//
WEBPROC Logout() PATH TC
   GETVAR UID AS nID

   oClient:CloseSession()

   FlashMessage( "You are now logged out...", "/", 2)
   debug( "TC_Logout: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

   Return

//-----------------------------------------------------------------------------
// After a user successfully logs in, this function will draw the outer frameset
// for the TimeClock app. This frameset contains a small 'header' frame along the
// top for common hyperlink shortcuts and a 'main' frame where the TimeClock app
// will be drawn.
//
// Although we can use client-side "cookies" to perform session management automatically.
// This will fail when a client has cookie support turned off. To make it work for all
// cases we need to pass the unique session handle within each URL hyperlink pointing
// back to the server.
//
STATIC FUNCTION DrawOuterFrame( cSessionHandle )
   Static cTemplate


   if cTemplate == NIL
   
      TEXT INTO cTemplate TRIMMED
      <!doctype html public "-//w3c//dtd html 4.0 frameset//en">
      <html>

      <head>
        <title>MrTienda WebServer</title>
        <link rel="stylesheet" media="screen" type="text/css" href="/style.css">
        <style type="text/css">
        body {margin:0px;}

        #red {position:absolute;
              top:0; left:0;
              width:100%;
              background-color:#FF3300;}
	      
        </style>
        </head>

	<frameset rows="10%,9%,*" frameborder=no border=0>
        <frame name=header src=Header?<%sid%> marginwidth=0 marginheight=0 frameborder=no scrolling=no noresize >
        <frame name=Negocio src=Negocio?<%sid%> marginwidth=0 marginheight=0 frameborder=no scrolling=no noresize>
        <frame name=main   src=TimeClock?<%sid%> marginwidth=0 marginheight=0 frameborder=no scrolling=auto>
        </frameset>

      <noframes>
        <body>
        <div id="red"></div>
        <center>
        <br><br><br>
        This page uses frames.<br>
        Your browser either does not support frames or you have turned frame support off.<p>
        <b><a href="TimeClock?" target="_top">click here to continue without frames</a></b>
        </center>
        </body>
        </noframes>

      </html>
      ENDTEXT
   endif

   Return StrTran(cTemplate, "<%sid%>", "_SID=" + cSessionHandle)


//-----------------------------------------------------------------------------
WEBPROC Header() PATH TC
   GETCARGO SECURITY AS nSecurity
   Static cTemplate
   Local cSID := oClient:GetSessionHandle()
   Local cLinks, cLOCALIDAD := ''

   CHECKLOGIN

   if Empty(nSecurity)
      oClient:SendFile( oClient:Parent:RootDir + "\TC\Login.htm" )
      Return
   endif

   debug( "TC_Header: SID", oClient:GetSessionHandle(), "# Sess", xbSession():ActiveSessions(), "CARGO", oClient:GetCargo())

   if cTemplate == NIL

/*
<meta http-equiv="refresh" content="10" >
*/
      TEXT INTO cTemplate TRIMMED
      <html>
      <head>
       <title>Http MrTienda</title>
       <link rel="stylesheet" media="screen" type="text/css" href="/style.css">
       <style type="text/css">
	</style>
	</head>
	<body>
	<img src="<%anuncio%>"  align="left"  usemap="#h4dmap">
	<map name="h4dmap">
	  <area shape="rect" coords = "0,0,220,084" href="<%ref1%>"     TARGET = "ventana-1">
	  <area shape="rect" coords = "225,0,407,084" href="<%ref2%>"  TARGET = "ventana-2">
	  <area shape="rect" coords = "410,0,600,084" href="<%ref3%>"  TARGET = "ventana-3">
	  <area shape="rect" coords = "605,0,795,084" href="<%ref4%>"  TARGET = "ventana-4">
	  <area shape="rect" coords = "800,0,1000,084" href="<%ref5%>" TARGET = "ventana-5">
	  </map>
	</body>
	</html>
      ENDTEXT
      
EndIf

   *
   * insertar banner de publicidad que corresponda a la zona !
   *
   If aINFOKEY[8] // incluir publicidad

	cLOCALIDAD := aANUNCIOS[nPOS_ANUNCIOS,1] 
	cTEMPLATE := StrTran(cTemplate, "<%ref1%>", aANUNCIOS[nPOS_ANUNCIOS,2], 1, 1)
	cTEMPLATE := StrTran(cTemplate, "<%ref2%>", aANUNCIOS[nPOS_ANUNCIOS,3], 1, 1)
	cTEMPLATE := StrTran(cTemplate, "<%ref3%>", aANUNCIOS[nPOS_ANUNCIOS,4], 1, 1)
	cTEMPLATE := StrTran(cTemplate, "<%ref4%>", aANUNCIOS[nPOS_ANUNCIOS,5], 1, 1)
	cTEMPLATE := StrTran(cTemplate, "<%ref5%>", aANUNCIOS[nPOS_ANUNCIOS,6], 1, 1)
	nPOS_ANUNCIOS++
	If nPOS_ANUNCIOS > LEN(aANUNCIOS)
		nPOS_ANUNCIOS := 1
	EndIf

   Else
	cLOCALIDAD := "/mibanner.gif" // banner propio de la empresa : paga renta mayor !
   EndIf
   
   oClient:HTTPResponse:Content := StrTran(cTemplate, "<%anuncio%>", cLOCALIDAD, 1, 1)

Return

//-----------------------------------------------------------------------------
STATIC FUNCTION HeaderLink( cDisplay, cFunction, cSID )
   Return '<td class=link><img src=/4dot.gif> <a href=' + cFunction +;
          '?_SID=' + cSID + ' class="cold" title="' + cDisplay +;
          '" target=main>' + cDisplay + '</a></td>'


