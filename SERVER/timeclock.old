//-----------------------------------------------------------------------------
WEBPROC ChangePassword() PATH TC
   GETCARGO UID  AS nID
   GETVAR   OLD  AS cPWD
   GETVAR   NEW1 AS cNew1
   GETVAR   NEW2 AS cNew2

   CHECKLOGIN

   if ! cNew1 == cNew2
      FlashError( "The new password and confirmation do not match!" )
      Return
   endif

   USE employee ALIAS emp INDEX employee SHARED NEW

   if !(DbSeek(nID, .f.) .and. Upper(Trim(emp->password)) == Upper(Trim(cPWD)))
      FlashError( "Invalid password!" )
   elseif dbRLock()
      emp->password := cNew1
      FlashMessage( "Password changed...", "TimeClock?_SID=" + oClient:GetSessionHandle())
   else
      FlashError( "ERROR: Unable to obtain database record lock.<br>Try again..." )
   endif

   dbCLoseAll()
   Return

//-----------------------------------------------------------------------------
WEBPROC BrowseTable( cBase64String ) PATH TC
   Local cHtml

   CHECKLOGIN

   TEXT INTO cHtml TRIMMED
      <html><head>
      <link rel="stylesheet" type="text/css" href="/Style.css"></head>
      <body bgcolor=black style=margin:0px;>
   ENDTEXT

   ThreadObject():HTTPResponse:Content := cHtml + DrawTableGrid( cBase64String ) + "</body></html>"

   Return

//-----------------------------------------------------------------------------
STATIC FUNCTION DrawTableGrid( cBase64String, nMaxRows )
   Local i, cHtml, cPrev, cNext, n
   Local cTable, xTag, xTopScope, xBotScope, cHeading, aFields, bFilter, nFields, aParam
   Local nRows    := 0
   Local oClient  := ThreadObject()
   Local oURL     := xbURI():New()
   Local nDir     := iif(oClient:GetVar("DIR")==NIL, 1, Val(oClient:GetVar("DIR")))
   Local nFromRec := iif(oClient:GetVar("POS")==NIL, 0, Val(oClient:GetVar("POS")))

   DEFAULT nMaxRows TO 25

   // decode the params from the base64 string
   if !Empty( cBase64String )
      aParam := &(xbBase64Decode( cBase64String ))
   endif

   // this would be so much simpler with SQL
   cTable   := aParam[1]
   xTag     := aParam[2]
   xTopScope:= aParam[3]
   xBotScope:= aParam[4]
   cHeading := aParam[5]
   aFields  := aParam[6]
   bFilter  := aParam[7]

   USE (cTable) INDEX (cTable) SHARED NEW
   SET DELETED ON

   if ! Empty(xTag)
      OrdSetFocus(xTag)
   endif

   if xTopScope != NIL
      dbSetScope(SCOPE_TOP, xTopScope)
   endif

   if xBotScope != NIL
      dbSetScope(SCOPE_BOTTOM, xBotScope)
   endif

   if ValType(bFilter) == "B"
      dbSetFilter( bFilter )
   endif

   if Empty(aFields)
      nFields := FCount()
      aFields := Array(nFields)
      for i := 1 to nFields
         aFields[i] := i
      next
   else
      nFields := Len(aFields)
   endif


   oURL:Path("BrowseTable('" + cBase64String + "')")
   oURL:SetVar(oClient:Parent:SessionTag, oClient:GetSessionHandle())

   cHtml := "<table width=90% align=center><tr>"

   if ! Empty(cHeading)
      cHtml += "<th colspan=" + NTrim(nFields) + ">" + cHeading + "<br>&nbsp;</th></tr></tr>"
   endif

   // draw column headings
   for i := 1 to nFields
      cHtml += "<th>" + FieldName(aFields[i]) + "</th>"
   next

   cHtml += "</tr>"

   if nFromRec == 0
      dbGoTop()
   else
      dbGoTo(nFromRec)
      if nDir < 0
         // skip back nMaxRows
         dbSkip(-nMaxRows)
      endif
      // skip back to see if we're at the top
      // no sense of displaying "Prev Page" link if we're already at the top
      dbSkip(-1)
      if !Bof()
         dbSkip()
         oURL:SetVar("DIR", "-1")
         oURL:SetVar("POS", NTrim(RecNo()))
         cPrev := oURL:AsString()
      endif
   endif

   // draw the table contents
   n := 0
   while !Eof() .and. ++nRows <= nMaxRows
      if (++n % 2) == 0
         cHtml += "<tr class=r0>"
      else
         cHtml += "<tr class=r1>"
      endif
      for i := 1 to nFields
         cHtml += "<td>" + Var2Char(FieldGet( aFields[i] )) + "</td>"
      next
      cHtml += "</tr>"
      dbSkip()
   enddo

   if !Eof()
      // add page down link only if we're not at EOF
      oURL:SetVar("DIR", "1")
      oURL:SetVar("POS", NTrim(RecNo()))
      cNext := oURL:AsString()
   endif

   // add hyperlinks for page up/down
   cHtml += "<tr><th colspan=" + NTrim(nFields) +" style='text-align:right;'><br>" +;
            iif(cPrev==Nil, "<font style=color:gray;>Prev Page</font>", "<a href=" + cPrev + ">Prev Page</a>") + ;
            " | " +;
            iif(cNext==Nil, "<font style=color:gray;>Next Page</font>", "<a href=" + cNext + ">Next Page</a>") +;
            "</th></tr>" +;
            "</table>"

   dbCLoseAll()

   Return cHtml

//----------------------------------------------------------------------------------------------------
STATIC FUNCTION LockRecord()
   Local i := 0

   for i := 1 to 10   // try for a max 5 sec
      if dbRLock()
         return .t.
      endif
      sleep( 50 )
   next

   dbCLoseAll()
   Break( "Unable to obtain record lock!" )  // unable to lock record -- this will cause an error to be returned to the client
   Return .f.

//-----------------------------------------------------------------------------
STATIC FUNCTION isLoggedIn()
   if Empty(ThreadObject():GetCargo("UID"))
      ThreadObject():CloseSession()
      FlashError("You need to log in first...", "Login.htm")
      Return .F.
   endif
   Return .T.

//-----------------------------------------------------------------------------
STATIC FUNCTION HaveSecurityPrivilege( nLevel )
   DEFAULT nLevel TO SEC_ADMIN
   if ThreadObject():GetCargo("SECURITY") >= nLevel
      Return .T.
   endif
   FlashError("Sorry, you do not have access to this function!", "TimeClock?_SID=" + ThreadObject():GetSessionHandle())
   Return .F.


