*
* EXISTENCIAS : POR DESCRIPCION
*

WEBPROC EXISTEN2() PATH TC

   Local cDESC    := oClient:GetVar("DESC")

If fvACCESO(1)

   cDESC := Upper(Trim(cDESC))

cFILENAME := cDBFPATH + 'PRODUCTO.DBF'

   if FExists( cFileName )

		aFILES := dARRAY({'PRODUCTO','CODIGOS','STOCKS'})
		fVIDMAIN(.t., aFILES)

		TEXT INTO cHtml TRIMMED
			<BR><B><FONT SIZE="12">RESULTADOS :</B><BR>
			<TABLE><TABLE BORDER='5'>
			<TR><TD BGCOLOR="FFCCFF">PLU</TD><TD BGCOLOR="FFCCFF">DESCRIPCION</TD><TD BGCOLOR="FFCCFF">EXISTENCIA</TD></TR>
		ENDTEXT

		If .not. EMPTY(cDESC)

			PRODUCTO->( ordsetfocus( 4))
			PRODUCTO->(DbGoTop())
			Do While .not. PRODUCTO->(Eof())
				If cDESC$UPPER(PRODUCTO->DES_PROD)

					CODIGOS->( ordsetfocus( 1))
					If CODIGOS->(DbSeek(PRODUCTO->COD_PROD))
					
						STOCKS->( ordsetfocus( 2))
						If STOCKS->(DbSeek(PRODUCTO->COD_PROD + cCOD_MAIN_ALMA + CODIGOS->SIZE + CODIGOS->ATRIB ))
							cHtml+='<TR><TD>'+CODIGOS->COD_PLU+'</TD><TD>'+PRODUCTO->DES_PROD+'</TD><TD>'+ Trans(STOCKS->EXISTE,'999,999,999.999') +'</TD></TR>'
						EndIf
					EndIf
					
				Endif
				PRODUCTO->(DbSkip())
			EndDo
		EndIf

		cHtml+='</TABLE>'
		oClient:HTTPResponse:Content  := cHtml
		
		fVIDMAIN(.f., aFILES)

   else
      FlashError('** ERROR **')
   endif
Else
	FlashError('** NO TIENE ACCESO **')
Endif
Return


*
* EXISTENCIAS POR PLU
*
WEBPROC Existen1() PATH TC
Local cPLU     := oClient:GetVar("PLU")

If fvACCESO(1)

	cFILENAME := cDBFPATH + 'PRODUCTO.DBF'

	if FExists( cFileName )

	aFILES := dARRAY({'PRODUCTO','CODIGOS','STOCKS'})
	fVIDMAIN(.t., aFILES)

	TEXT INTO cHtml TRIMMED
		<BR><B><FONT SIZE="12">RESULTADOS :</B><BR>
		<TABLE><TABLE BORDER='5'>
		<TR><TD BGCOLOR="FFCCFF">PLU</TD><TD BGCOLOR="FFCCFF">DESCRIPCION</TD><TD BGCOLOR="FFCCFF">EXISTENCIA</TD></TR>
	ENDTEXT

	If .not. EMPTY(cPLU)

		cCOD_PLU := Space(15-len(cPLU)) + cPLU
		CODIGOS->( ordsetfocus( 2))
		If CODIGOS->(DbSeek(cCOD_PLU))

			PRODUCTO->( ordsetfocus( 1))
			If PRODUCTO->(DbSeek(CODIGOS->COD_PROD))

				STOCKS->( ordsetfocus( 2))
				If STOCKS->(DbSeek(PRODUCTO->COD_PROD + cCOD_MAIN_ALMA + CODIGOS->SIZE + CODIGOS->ATRIB ))
					cHtml+='<TR><TD>'+CODIGOS->COD_PLU+'</TD><TD>'+PRODUCTO->DES_PROD+'</TD><TD>'+ Trans(STOCKS->EXISTE,'999,999,999.999') +'</TD></TR>'
				EndIf
			EndIf
		Else
				cHtml += 'NO SE ENCONTRO CODIGO PLU : ' + cPLU+ '<br>'
		EndIf

	EndIf

	cHtml+='</TABLE>'

	oClient:HTTPResponse:Content  := cHtml

	fVIDMAIN(.f., aFILES)
	EndIf
Else
	FlashError('** NO TIENE ACCESO **')
Endif

Return


*
* REPORTE DE ASISTENCIAS
*
WEBPROC RepAsis() PATH TC

Local cFECHA := oClient:GetVar('orderdate'), dFECHA
Local cFILENAME := cDBFPATH + 'CLIENTES.DBF'

If fvACCESO(8)

	if FExists( cFileName ) .AND. .NOT. EMPTY(cFECHA)

		dFECHA := CTOD(cFECHA)

		aFILES := dARRAY({'PAREA','CHECK'})
		fVIDMAIN(.t., aFILES)

		TEXT INTO cHtml TRIMMED
			<BR><B><FONT SIZE="12">REPORTE DE ASISTENCIAS</B><BR>
		ENDTEXT
		
		cHTML+='<B><FONT SIZE="6">' +   cFECHA  +'</B><BR>'
		
		cHTML+="<TABLE><TABLE BORDER='5'>"
		cHTML+='<TR><TD BGCOLOR="FFCCFF">EMPLEADO</TD><TD BGCOLOR="FFCCFF">FECHA ENTRADA</TD><TD BGCOLOR="FFCCFF">HORA</TD> <TD BGCOLOR="FFCCFF">FECHA SALIDA</TD> <TD BGCOLOR="FFCCFF">HORA</TD> <TD BGCOLOR="FFCCFF">TIEMPO</TD></TR>'

		CHECK->( ordsetfocus( 3 ))
		CHECK->(DbSetFilter( {||  CHECK->FECHA_IN == dFECHA  } ))
		CHECK->(DbGoTop())
		Do WHILE .not. CHECK->(Eof())

			PAREA->( ordsetfocus( 2 ))
			If PAREA->(DbSeek(CHECK->COD_CLERK))
					
				nMINUTOS := fdMINS(CHECK->FECHA_OUT, CHECK->HORA_OUT,CHECK->FECHA_IN, CHECK->HORA_IN)
				cHtml+=  '<TR><TD>'+PAREA->DES_EMPLEA+'</TD><TD>'+DTOC(CHECK->FECHA_IN)+'</TD><TD>'+ CHECK->HORA_IN +'</TD><TD>'+  DTOC(CHECK->FECHA_OUT) +'</TD>'+ '<TD>'+  CHECK->HORA_OUT +'</TD>'+ '<TD ALIGN=RIGHT>'+  fdHORAS(nMINUTOS)  +'</TD></TR>'
				
			Endif

			CHECK->(DbSkip())
		EndDo

		cHtml+='</TABLE>'

		dbselectarea('CHECK')
		Set Filter TO
		CHECK->(DbGoTop())
		
		fVIDMAIN(.f., aFILES)
		oClient:HTTPResponse:Content  := cHtml
		
	Else
	      FlashError('** ERROR **')
	EndIf
Else
      FlashError('** NO TIENE ACCESO **')
Endif

Return


Static Function fdMINS(dFECHA_ACT, cHORA_ACT, dFECHA_INI, cHORA_INI)
Local nMINUTOS := 0, nMIN_DIA, nMIN_ACT, nHRAS, nMINS

If .not. EMPTY(dFECHA_ACT) .and. .not. EMPTY(dFECHA_INI)
	nMIN_DIA := (dFECHA_ACT - dFECHA_INI) * 24 * 60 // DIFERENCIA DE DIAS
	nMIN_INI := Val(Substr(cHORA_INI,1,2))*60 + Val(Substr(cHORA_INI,4,2))
	nMIN_ACT := Val(Substr(cHORA_ACT,1,2))*60 + Val(Substr(cHORA_ACT,4,2))

	nMINUTOS := nMIN_DIA - nMIN_INI + nMIN_ACT

Endif
Return nMINUTOS


Static Function fdHORAS(nMINUTOS)
Local cRET_VAL := ''

nHRAS    := Int(nMINUTOS / 60)
nMINS    := Int((nMINUTOS/60-Int(nMINUTOS/60))*60)
If (nMINUTOS/60-Int(nMINUTOS/60))*60 - nMINS > 0
	nMINS++
Endif
cRET_VAL := If(nHRAS==0,space(7),Str(nHRAS,4)+' hr') + ' ' + Str(nMINS, 2) +' min'

Return cRET_VAL

Function fvACCESO(nACCESO)
Return If(Substr(ThreadObject():GetCargo("ACCESO_3"), nACCESO,1)=='1',.T.,.F.)



*
* CONSULTAR ESTADO DE CUENTA
*

WEBPROC EdoCta1() PATH TC
Local cCOD_UNICO := oClient:GetVar("COD_UNICO")
Local nTOTAL1 := 0, nTOTAL2 := 0, nTOTAL3 := 0
cFILENAME := cDBFPATH + 'CLIENTES.DBF'

If fvACCESO(6)

	if FExists( cFileName ) .AND. .NOT. EMPTY(cCOD_UNICO)

			aFILES := dARRAY({'CLIENTES','CXC','CXC_MOVS'})
			fVIDMAIN(.t., aFILES)

			CLIENTES->( ordsetfocus( 6))
			If CLIENTES->(DbSeek(cCOD_UNICO))

				TEXT INTO cHtml TRIMMED
					<BR><B><FONT SIZE="12">RESULTADOS :</B><BR>
				ENDTEXT
				
				cHTML+='<B><FONT SIZE="8">' + CLIENTES->CTE_NOMBRE+'</B><BR>'
				cHTML+=Alltrim(CLIENTES->CTE_DIREC1)+' ' + Alltrim(CLIENTES->CTE_DIREC2)+ ' ' + Alltrim(CLIENTES->CTE_DIREC3)+ '<BR>'

				cHTML+="<TABLE><TABLE BORDER='5'>"
				cHTML+='<TR><TD BGCOLOR="FFCCFF">FECHA</TD><TD BGCOLOR="FFCCFF">TICKET</TD><TD BGCOLOR="FFCCFF">CARGOS</TD> <TD BGCOLOR="FFCCFF">ABONOS</TD> <TD BGCOLOR="FFCCFF">SALDO</TD> </TR>'

				CXC->( ordsetfocus( 3))
				CXC->(DbSeek(CLIENTES->COD_CTE))
				Do While .not. CXC->(Eof()) .and. CXC->COD_CTE == CLIENTES->COD_CTE
					If CXC->SALDO > 0
						cHtml+='<TR><TD>'+dtoc(CXC->FECHA)+'</TD><TD>'+CXC->FOL_VENTA+'</TD><TD ALIGN=RIGHT>'+ Trans(CXC->CARGOS,'99,999,999.99') +'</TD>'+ '<TD ALIGN=RIGHT>'+ Trans(CXC->ABONOS,'99,999,999.99') +'</TD>'+ '<TD ALIGN=RIGHT>'+ Trans(CXC->SALDO,'99,999,999.99') +'</TD></TR>'
						nTOTAL1+=CXC->CARGOS
						nTOTAL2+=CXC->ABONOS
						nTOTAL3+=CXC->SALDO
					Endif
					CXC->(DbSkip())
				EndDo
				cHtml+='<TR><TD>'+'TOTALES:'+'</TD><TD>'+''+'</TD><TD ALIGN=RIGHT>'+ Trans(nTOTAL1,'99,999,999.99') +'</TD>'+ '<TD ALIGN=RIGHT>'+ Trans(nTOTAL2,'99,999,999.99') +'</TD>'+ '<TD ALIGN=RIGHT>'+ Trans(nTOTAL3,'99,999,999.99') +'</TD></TR>'
				cHtml+='</TABLE>'

				oClient:HTTPResponse:Content  := cHtml
			Else
				FlashError('** NO SE ENCONTRO CLIENTE !!! **')
			EndIf
			fVIDMAIN(.f., aFILES)

	else
	      FlashError('** ERROR **')
	EndIf
Else
      FlashError('** NO TIENE ACCESO **')
Endif
Return


Function fFUERA_HORARIO()
Local lRET_VAL := .T.
Local dFECHA := DATE()
Local cHORA  := Substr(TIME(),1,5)
Local aDIAS := {'DOM','LUN','MAR','MIE','JUE','VIE','SAB'}

If PAREA->LIMITAR // LIMITACION DE HORARIO

	cCAMPO := aDIAS[dow(dFECHA)]
	If PAREA->&cCAMPO // aplica en el dia de la semana

		If dFECHA >= PAREA->FECHAI .and. dFECHA <= PAREA->FECHAF

			*
			* REVISION DE HORARIO
			*

			lHORARIO := .f.

			*
			* NO ES FECHA INICIAL NI FECHA FINAL : DENTRO DEL PERIODO
			*
			If dFECHA <> PAREA->FECHAI .and. dFECHA <> PAREA->FECHAF
				If cHORA>=PAREA->HORAI .and. cHORA<=PAREA->HORAF
					lHORARIO := .t.
				EndIf
			Endif

			*
			* IGUAL A FECHA DE INICIO PERO DIFERENTE A LA FECHA FINAL
			*
			If dFECHA == PAREA->FECHAI .and. dFECHA <> PAREA->FECHAF
				If cHORA>=PAREA->HORAI .and. cHORA<=PAREA->HORAF
					lHORARIO := .t.
				Endif
			Endif

			*
			* DIFENTE A FECHA DE INICIO PERO IGUAL A FECHA FINAL
			*
			If dFECHA <> PAREA->FECHAI .and. dFECHA == PAREA->FECHAF
				If cHORA>=PAREA->HORAI .and. cHORA<=PAREA->HORAF
					lHORARIO := .t.
				Endif
			Endif

			*
			* IGUAL A FECHA DE INICIO Y A FECHA FINAL
			*
			If dFECHA == PAREA->FECHAI .and. dFECHA == PAREA->FECHAF
				If cHORA>=PAREA->HORAI .and. cHORA<=PAREA->HORAF
					lHORARIO := .t.
				Endif
			Endif

			If lHORARIO
				lRET_VAL := .f.
			Else
				lRET_VAL := .T.
			Endif

		Endif
	EndIf
Else
	lRET_VAL := .f.
EndIf
Return lRET_VAL



